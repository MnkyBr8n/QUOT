# Watsonx Configuration
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_APIKEY=your_watsonx_api_key_here
WATSONX_PROJECT_ID=your_project_id_here

# Model Configuration
LLM_MODEL=mistralai/mixtral-8x7b-instruct-v01
TEMPERATURE=0.0
MAX_NEW_TOKENS=512

# Available Watsonx LLM Models:
#   - mistralai/mixtral-8x7b-instruct-v01 (recommended)
#   - meta-llama/llama-3-70b-instruct
#   - ibm/granite-13b-chat-v2
#   - google/flan-ul2

# Embeddings (HuggingFace - runs locally, no API key needed)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
DEVICE=cpu

# Vector Database
CHROMA_PERSIST_DIR=chroma_db

# Text Splitting
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Retrieval
RETRIEVAL_K=3

# Discord Bot (optional)
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# API Configuration (optional)
API_URL=http://localhost:8000

# Weights & Biases (optional)
WANDB_API_KEY=your_wandb_api_key_here
WANDB_PROJECT= your_wandb_project_name_here
WANDB_ENTITY=
