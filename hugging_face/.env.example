# ============================================================================
# HUGGINGFACE CONFIGURATION
# ============================================================================

# Mode Selection: API (recommended) or Local
USE_LOCAL_MODEL=false

# ----------------------------------------------------------------------------
# API MODE (USE_LOCAL_MODEL=false) - Recommended for Starting
# ----------------------------------------------------------------------------
# Uses HuggingFace Inference API - models run on HuggingFace servers
# Get FREE API key at: https://huggingface.co/settings/tokens

HUGGINGFACE_API_KEY=hf_your_huggingface_api_key_here

# API Mode Models (choose one):
# - google/flan-t5-base (fast, good for learning)
# - mistralai/Mistral-7B-Instruct-v0.2 (recommended)
# - meta-llama/Llama-2-7b-chat-hf (high quality)
# - HuggingFaceH4/zephyr-7b-beta (very good)

LLM_MODEL=mistralai/Mistral-7B-Instruct-v0.2

# ----------------------------------------------------------------------------
# LOCAL MODE (USE_LOCAL_MODEL=true) - For Learning & Offline Use
# ----------------------------------------------------------------------------
# Downloads and runs models on your machine
# No API key needed, completely free!
# Uncomment these if using local mode:

# USE_LOCAL_MODEL=true

# Local Mode Models (choose based on your hardware):
# - TinyLlama/TinyLlama-1.1B-Chat-v1.0 (1.1B - runs on laptop, ~2GB RAM)
# - microsoft/phi-2 (2.7B - good quality, ~5GB RAM)
# - mistralai/Mistral-7B-Instruct-v0.2 (7B - needs GPU, ~14GB VRAM)
# - meta-llama/Llama-2-7b-chat-hf (7B - needs GPU, ~14GB VRAM)

# LLM_MODEL=TinyLlama/TinyLlama-1.1B-Chat-v1.0

# Device: cpu or cuda (GPU)
# DEVICE=cpu  # Use 'cuda' if you have NVIDIA GPU

# ============================================================================
# EMBEDDINGS CONFIGURATION
# ============================================================================
# Embeddings run locally (no API key needed)

# Embedding Models (choose based on speed vs quality):
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Options:
# - all-MiniLM-L6-v2 (fast, 80MB, good quality - recommended)
# - all-MiniLM-L12-v2 (balanced, 120MB, better quality)
# - all-mpnet-base-v2 (best quality, 420MB, slower)
# - paraphrase-multilingual-MiniLM-L12-v2 (multilingual, 470MB)

# Device for embeddings: cpu or cuda
DEVICE=cpu

# ============================================================================
# GENERAL CONFIGURATION
# ============================================================================

TEMPERATURE=0.1
MAX_NEW_TOKENS=512

# Vector Database
CHROMA_PERSIST_DIR=chroma_db

# Text Splitting
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Retrieval
RETRIEVAL_K=3

# ============================================================================
# OPTIONAL: DISCORD BOT
# ============================================================================
# DISCORD_BOT_TOKEN=your_discord_bot_token_here

# ============================================================================
# OPTIONAL: API CONFIGURATION
# ============================================================================
# API_URL=http://localhost:8000

# ============================================================================
# QUICK START EXAMPLES
# ============================================================================
#
# Example 1: API Mode (Easiest - Recommended for Portfolio)
# USE_LOCAL_MODEL=false
# HUGGINGFACE_API_KEY=hf_your_key
# LLM_MODEL=mistralai/Mistral-7B-Instruct-v0.2
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# DEVICE=cpu
#
# Example 2: Local Mode on Laptop (No GPU)
# USE_LOCAL_MODEL=true
# LLM_MODEL=TinyLlama/TinyLlama-1.1B-Chat-v1.0
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# DEVICE=cpu
#
# Example 3: Local Mode with GPU
# USE_LOCAL_MODEL=true
# LLM_MODEL=mistralai/Mistral-7B-Instruct-v0.2
# EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
# DEVICE=cuda
#
# ============================================================================
