# Anthropic Configuration
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here

# OpenAI Configuration (for embeddings - Anthropic doesn't provide embeddings)
OPENAI_API_KEY=sk-your_openai_api_key_here

# Google Configuration (alternative for embeddings)
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_CSE_ID=your_custom_search_engine_id_here

# Model Configuration
LLM_MODEL=claude-3-5-haiku-20241022
EMBEDDING_MODEL=text-embedding-3-small
TEMPERATURE=0.0
MAX_NEW_TOKENS=512

# Available Anthropic LLM Models:
#   - claude-3-5-sonnet-20241022 (recommended - best balance)
#   - claude-3-opus-20240229 (most capable)
#   - claude-3-haiku-20240307 (fastest, cheapest)

# Embeddings Options (Anthropic doesn't provide embeddings):
#   - Google (current): models/embedding-001
#   - OpenAI alternative: text-embedding-3-small
#   - HuggingFace (free, local): sentence-transformers/all-MiniLM-L6-v2

# Vector Database
CHROMA_PERSIST_DIR=chroma_db

# Text Splitting
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Retrieval
RETRIEVAL_K=3

# Discord Bot (optional)
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# API Configuration (optional)
API_URL=http://localhost:8000

# Weights & Biases (optional)
WANDB_API_KEY=your_wandb_api_key_here
WANDB_PROJECT=your_wandb_project_name_here
WANDB_ENTITY=
