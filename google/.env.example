# Google Configuration
GOOGLE_API_KEY=  your_google_api_key_here

GOOGLE_CSE_ID=your_custom_search_engine_id_here

# OpenAI Configuration (for embeddings when Google quota exhausted)
OPENAI_API_KEY=your_openai_api_key_here




# Model Configuration
LLM_MODEL=gemini-2.0-flash
EMBEDDING_MODEL=models/embedding-001
TEMPERATURE=0.0
MAX_NEW_TOKENS=512

# Available Google Models:
# LLM Models:
#   - gemini-1.5-flash (recommended - fast and cheap)
#   - gemini-1.5-pro (best quality, larger context)
#   - gemini-1.0-pro (legacy, cheaper)
# Embedding Models:
#   - models/embedding-001 (recommended)
#   - models/text-embedding-004 (newer)

# Vector Database
CHROMA_PERSIST_DIR=chroma_db

# Text Splitting
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Retrieval
RETRIEVAL_K=3

# Discord Bot (optional)
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# API Configuration (optional)
API_URL=http://localhost:8000

# Weights & Biases (optional)
WANDB_API_KEY=your_wandb_api_key_here
WANDB_PROJECT=your_wandb_project_name_here
WANDB_ENTITY=
