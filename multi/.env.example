# =============================================================================
# MULTI-PROVIDER CONFIGURATION
# =============================================================================
# Choose your AI provider: watsonx, openai, anthropic, or google
PROVIDER=openai

# =============================================================================
# WATSONX CONFIGURATION (if PROVIDER=watsonx)
# =============================================================================
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_APIKEY=your_watsonx_apikey_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here

# =============================================================================
# OPENAI CONFIGURATION (if PROVIDER=openai)
# =============================================================================
OPENAI_API_KEY=sk-...your_openai_api_key_here...
# =============================================================================
# ANTHROPIC CONFIGURATION (if PROVIDER=anthropic)
# =============================================================================
# Anthropic has no embedding API. Set EMBEDDING_PROVIDER to use OpenAI or
# Google for embeddings while still using Claude as the LLM.
# EMBEDDING_PROVIDER=openai   # or: google
ANTHROPIC_API_KEY=sk-ant-...your_anthropic_api_key_here...

# =============================================================================
# GOOGLE CONFIGURATION (if PROVIDER=google)
# =============================================================================
GOOGLE_API_KEY=your_google_api_key_here...

# =============================================================================
# MODEL CONFIGURATION (provider-specific)
# =============================================================================
# Set based on your PROVIDER:

# Watsonx models:
# LLM_MODEL=mistralai/mixtral-8x7b-instruct-v01
# EMBEDDING_MODEL=ibm/slate-embedding-125m

# OpenAI models:
LLM_MODEL=gpt-3.5-turbo
EMBEDDING_MODEL=text-embedding-3-small

# Anthropic models (requires separate embedding provider — see EMBEDDING_PROVIDER above):
# LLM_MODEL=claude-3-5-sonnet-20241022
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# Note: Also set OPENAI_API_KEY when EMBEDDING_PROVIDER=openai

# Google models:
# LLM_MODEL=gemini-1.5-flash
# EMBEDDING_MODEL=models/embedding-001

# =============================================================================
# GENERAL CONFIGURATION (works for all providers)
# =============================================================================
TEMPERATURE=0.0
MAX_NEW_TOKENS=512

# Vector Database
CHROMA_PERSIST_DIR=chroma_db

# Text Splitting
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Retrieval
RETRIEVAL_K=3

# =============================================================================
# DISCORD BOT (optional)
# =============================================================================
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# =============================================================================
# API CONFIGURATION (optional)
# =============================================================================
API_URL=http://localhost:8000


# Weights & Biases (optional)
WANDB_API_KEY=your_wandb_api_key_here...
WANDB_PROJECT= your_wandb_project_name_here...
WANDB_ENTITY=

# =============================================================================
# QUICK START EXAMPLES
# =============================================================================
#
# Example 1: OpenAI (Recommended for getting started)
# PROVIDER=openai
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-3.5-turbo
# EMBEDDING_MODEL=text-embedding-3-small
#
# Example 2: Anthropic Claude (with OpenAI embeddings)
# PROVIDER=anthropic
# EMBEDDING_PROVIDER=openai
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# LLM_MODEL=claude-3-5-sonnet-20241022
# EMBEDDING_MODEL=text-embedding-3-small
#
# Example 3: Google Gemini
# PROVIDER=google
# GOOGLE_API_KEY=...
# LLM_MODEL=gemini-1.5-flash
# EMBEDDING_MODEL=models/embedding-001
#
# Example 4: IBM Watsonx
# PROVIDER=watsonx
# WATSONX_URL=https://us-south.ml.cloud.ibm.com
# WATSONX_APIKEY=...
# WATSONX_PROJECT_ID=...
# LLM_MODEL=mistralai/mixtral-8x7b-instruct-v01
# EMBEDDING_MODEL=ibm/slate-embedding-125m
